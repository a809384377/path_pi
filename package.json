{
  "name": "pi-agent-mcp",
  "version": "0.1.0",
  "description": "A reusable pool of persistent Pi coding-agent sessions exposed over MCP",
  "type": "module",
  "bin": {
    "pi-agent-mcp": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js"
  },
  "engines": {
    "node": ">=22.19 <26"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "mcp",
    "pi",
    "coding-agent",
    "subagent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/a809384377/path_pi.git"
  },
  "homepage": "https://github.com/a809384377/path_pi#readme",
  "bugs": {
    "url": "https://github.com/a809384377/path_pi/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fs-ext-extra-prebuilt": "2.2.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "typescript": "5.9.3"
  }
}
